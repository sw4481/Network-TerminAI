{
  "created_on": "2026-11-05",
  "upstream_revision": "c676a294f92aed89981ca30135d4f0ba9a67dcc1",
  "purpose": "Synthetic Phase 0 interoperability fixtures. No importer is implemented in Phase 1; expected fields describe future import acceptance criteria, not current runtime behavior.",
  "cases": [
    {
      "name": "parallel_ports_aligned_protocols_unicode_and_reverse_claim",
      "map": {
        "core-α.example": {
          "node_details": {"ip": "192.0.2.10", "platform": "IOS XE", "model": "synthetic-switch", "serial": "", "os_version": "", "vendor": "cisco"},
          "peers": {
            "edge-β.example": {"ip": "192.0.2.11", "platform": "IOS XE", "connections": [["Gi1/0/1", "Gi1/0/24"], ["Gi1/0/2", "Gi1/0/23"], ["Gi1/0/1", "Gi1/0/24"]], "protocols": ["cdp", "lldp", "lldp"]}
          }
        },
        "edge-β.example": {
          "node_details": {"ip": "192.0.2.11", "platform": "IOS XE"},
          "peers": {"core-α.example": {"ip": "192.0.2.10", "platform": "IOS XE", "connections": [["Gi1/0/24", "Gi1/0/1"]], "protocols": ["cdp"]}}
        }
      },
      "expected": {"valid": true, "nodes": 2, "distinct_port_pairs": 2, "distinct_protocol_observations": 3, "bidirectionally_verified_by_app": false}
    },
    {
      "name": "legacy_missing_protocols_and_missing_peer",
      "map": {
        "seed.example": {
          "node_details": {"ip": "192.0.2.20", "platform": "IOS XE"},
          "peers": {"uncollected.example": {"ip": "192.0.2.21", "platform": "Unknown", "connections": [["Gi1/0/3", "Ethernet1"]]}}
        }
      },
      "expected": {"valid": true, "nodes_including_placeholders": 2, "protocol": "unknown", "peer_collection_status": "unknown", "network_requests": 0}
    },
    {
      "name": "routing_eigrp_is_not_a_physical_cable",
      "map": {
        "router-a.example": {
          "node_details": {"ip": "192.0.2.30", "platform": "IOS XE"},
          "peers": {"router-b.example": {"ip": "192.0.2.31", "platform": "IOS XE", "connections": [["Vlan100", "unknown"]], "protocols": ["eigrp"]}}
        }
      },
      "expected": {"valid": true, "protocol": "eigrp", "relationship": "routing", "physical_link_verified": false, "live_eigrp_collection_proven": false}
    },
    {
      "name": "ambiguous_short_names_are_distinct_map_keys",
      "map": {
        "edge.site-a.example": {"node_details": {"ip": "192.0.2.40", "platform": "IOS XE"}, "peers": {}},
        "edge.site-b.example": {"node_details": {"ip": "192.0.2.41", "platform": "IOS XE"}, "peers": {}}
      },
      "expected": {"valid": true, "nodes": 2, "merge_by_short_name": false}
    },
    {
      "name": "misaligned_supplied_protocols",
      "map": {
        "seed.example": {
          "node_details": {"ip": "192.0.2.50", "platform": "IOS XE"},
          "peers": {"peer.example": {"ip": "192.0.2.51", "connections": [["Gi1", "Gi2"], ["Gi3", "Gi4"]], "protocols": ["cdp"]}}
        }
      },
      "expected": {"valid": false, "reason": "protocols length must match connections", "database_unchanged": true}
    },
    {
      "name": "malformed_connection_pair",
      "map": {
        "seed.example": {"node_details": {"ip": "192.0.2.60"}, "peers": {"peer.example": {"connections": [["Gi1"]], "protocols": ["lldp"]}}}
      },
      "expected": {"valid": false, "reason": "connection requires local and remote port", "database_unchanged": true}
    },
    {
      "name": "malformed_json",
      "raw_json": "{\"seed.example\":",
      "expected": {"valid": false, "reason": "invalid JSON", "database_unchanged": true}
    },
    {
      "name": "labels_are_data_not_markup",
      "map": {
        "<switch & \"quoted\">": {"node_details": {"ip": "192.0.2.70", "platform": "synthetic"}, "peers": {}}
      },
      "expected": {"valid": true, "label_rendering": "escaped text", "network_requests": 0}
    }
  ]
}
